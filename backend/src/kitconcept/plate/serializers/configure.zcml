<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Serializers -->

  <adapter factory=".tasks.TaskSerializer" />

  <utility
      factory=".summary.JSONSummarySerializerMetadata"
      name="kitconcept.plate.summary_serializer_metadata"
      />

  <!-- Block serializers -->

  <subscriber
      factory=".comments.CommentsSerializer"
      provides="plone.restapi.interfaces.IBlockFieldSerializationTransformer"
      />

</configure>
