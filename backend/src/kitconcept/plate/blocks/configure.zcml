<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Handle Plate regions with "@type": "plate" like plone.restapi handles
       the legacy "@type": "__somersault__" -->

  <subscriber
      factory=".PlateRegionVisitor"
      provides="plone.restapi.interfaces.IBlockVisitor"
      />

  <subscriber
      factory=".PlateRegionLinksRetriever"
      provides="plone.restapi.interfaces.IBlockFieldLinkIntegrityRetriever"
      />

</configure>
