{
  "name": "@kitconcept/volto-plate",
  "version": "1.0.0-alpha.3",
  "description": "An add-on that adds a Plate.js block for Volto",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react",
    "plate"
  ],
  "author": "kitconcept, GmbH",
  "homepage": "https://github.com/kitconcept/volto-plate#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:kitconcept/volto-plate"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-ts": "tsc --project tsconfig.json",
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "artifact-release": "mkdir -p ../../artifacts && release-it && pnpm pack --pack-destination ../../artifacts",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [
    "@plone/plate"
  ],
  "dependencies": {
    "@platejs/caption": "^49.0.0",
    "@platejs/floating": "^49.0.0",
    "@platejs/link": "^49.0.0",
    "@plone/plate": "workspace:*",
    "@plone/components": "workspace:^",
    "@tailwindcss/postcss": "^4.2.1"
  },
  "peerDependencies": {
    "@platejs/ai": "^50.3.7",
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "semantic-ui-react": "^2.1.5"
  },
  "devDependencies": {
    "@platejs/dnd": "^50.3.1",
    "@platejs/media": "^49.0.0",
    "@platejs/playwright": "^52.0.11",
    "@playwright/test": "^1.58.0",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@plone/volto-slate": "workspace:*",
    "@storybook/react": "^8.6.12",
    "@types/lodash": "^4.17.20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "platejs": "^49.2.21",
    "playwright": "^1.58.0",
    "release-it": "^19.0.5",
    "tailwindcss": "catalog:",
    "typescript": "^5.7.3",
    "vitest": "^3.1.2"
  }
}
